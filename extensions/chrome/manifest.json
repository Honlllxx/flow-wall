{
  "manifest_version": 3,
  "name": "FlowWall Web Tracker",
  "version": "1.0.0",
  "description": "追踪网站浏览时长，通过WebSocket同步到FlowWall",
  "permissions": ["tabs", "storage", "activeTab"],
  "host_permissions": ["<all_urls>", "ws://localhost:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png"
    }
  },
  "externally_connectable": {
    "matches": ["chrome-extension://*"]
  }
}